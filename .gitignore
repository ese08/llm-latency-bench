# 依赖：sharp 只是本地一次性工具的 devDependency，不进仓库也不进 CI 运行时
node_modules/

# 报表产物，由 `node src/report.js --out report.html` 随时重新生成
report.html
report.*.html

# 用户自己的原始照片。压出来的 fixtures/ingredients-NN.jpg 是要 commit 的，
# 但原图往往带 EXIF GPS、也可能拍到不该公开的东西——这个仓库是公开的。
fixtures/raw/

# 本地密钥。CI 用的是 GitHub Secrets，任何 .env 都不该出现在仓库里
.env
.env.*

# 系统与编辑器杂物
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# ⚠️ results/ 绝对不要忽略。
# 采样产物 results/<YYYY-MM-DD>/round-*.jsonl 和 results/preflight-{ok,fail}-*.json
# 就是这个项目的全部价值所在，必须 commit 进仓库。
